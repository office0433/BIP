def is_missing_value(value):
    """Return True for scalar missing values from Python, Snowflake, or Pandas."""
    try:
        return value is None or pd.isna(value)
    except (TypeError, ValueError):
        return value is None


def safe_str(value, default=""):
    """Safely convert a value to string, handling missing values from Snowflake/Pandas."""
    if is_missing_value(value):
        return default
    return str(value)


def html_escape(value, default=""):
    """Escape values before injecting them into custom HTML tables."""
    return html.escape(safe_str(value, default))


def auto_captured_engineer_email(stored_email, current_user_email):
    """Use the stored engineer email when available, otherwise fall back to the current user."""
    stored = safe_str(stored_email).strip()
    current = safe_str(current_user_email, "unknown@company.com").strip()
    return stored or current or "unknown@company.com"


def safe_date_value(value):
    """Return a date object for Streamlit date_input, or None when unavailable."""
    if is_missing_value(value):
        return None
    if hasattr(value, "date"):
        try:
            return value.date()
        except Exception:
            pass
    if hasattr(value, "year") and hasattr(value, "month") and hasattr(value, "day") and not isinstance(value, str):
        return value
    text = str(value).strip()
    if not text:
        return None
    try:
        return pd.to_datetime(text).date()
    except Exception:
        return None


def dropdown_value(value):
    """Return a valid dropdown state value, preserving non-empty legacy values."""
    text = safe_str(value).strip()
    return text if text else PLACEHOLDER


def options_with_existing(options, current_value):
    """Keep legacy dropdown values selectable when editing existing records."""
    selected = dropdown_value(current_value)
    if selected != PLACEHOLDER and selected not in options:
        return [options[0], selected] + list(options[1:])
    return options


