        history_df = session.sql(f"""
            SELECT SOURCE_SYSTEM, INTERFACE_NAME, DATABASE_NAME, PSG_TABLE_NAME,
                   CASE
                       WHEN AUDIT_FILE_NAME LIKE 'DELETED_BY:%' THEN REPLACE(AUDIT_FILE_NAME, 'DELETED_BY:', '')
                       WHEN AUDIT_FILE_NAME LIKE 'UPDATED_BY:%' THEN REPLACE(AUDIT_FILE_NAME, 'UPDATED_BY:', '')
                       WHEN AUDIT_CURRENT = TRUE THEN ENGINEER_EMAIL_ID
                       ELSE ENGINEER_EMAIL_ID
                   END as CHANGED_BY,
                   CASE
                       WHEN AUDIT_CURRENT = TRUE AND AUDIT_END_DATE IS NULL THEN 'Active'
                       WHEN AUDIT_FILE_NAME LIKE 'DELETED_BY:%' THEN 'Deleted'
                       WHEN AUDIT_FILE_NAME LIKE 'UPDATED_BY:%' THEN 'Edited'
                       WHEN AUDIT_CURRENT = FALSE AND AUDIT_END_DATE IS NOT NULL THEN 'Superseded'
                       ELSE 'Unknown'
                   END as STATUS,
                   AUDIT_FILE_PROCESSED_DATE
            FROM {TABLE}
            ORDER BY AUDIT_FILE_PROCESSED_DATE DESC
            LIMIT {history_limit}
        """).to_pandas()

        if history_df.empty:
            st.info("No history found.")
        else:
            history_df = history_df.drop(columns=['AUDIT_FILE_PROCESSED_DATE'])
