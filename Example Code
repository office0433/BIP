def insert_entry(data):
    import datetime
    exp_val = data.get("EXPIRATION_DATE")
    if exp_val and not isinstance(exp_val, (datetime.date, datetime.datetime)):
        try:
            exp_val = pd.to_datetime(str(exp_val)).date()
        except Exception:
            raise ValueError("EXPIRATION_DATE must be a valid date")
        data["EXPIRATION_DATE"] = exp_val
    safe = {k: str(v).replace("'", "''") if v else "" for k, v in data.items()}
    cols = ", ".join(FIELD_COLUMNS)
    vals = []
    for column in FIELD_COLUMNS:
        value = safe.get(column, "")
        if column == "EXPIRATION_DATE" and not value:
            vals.append("NULL")
        else:
            vals.append("'" + value + "'")
    vals_sql = ", ".join(vals)
    hashkey_src = safe["SOURCE_SYSTEM"] + safe["INTERFACE_NAME"] + safe["DATABASE_NAME"] + safe["PSG_TABLE_NAME"]
    hashdiff_src = "".join(safe.get(c, "") for c in FIELD_COLUMNS)
    sql = f"""
        INSERT INTO {TABLE}
        ({cols}, AUDIT_FILE_PROCESSED_DATE, AUDIT_FILE_NAME, AUDIT_JOB_GUID,
         AUDIT_CURRENT, AUDIT_START_DATE, AUDIT_HASHKEY, AUDIT_HASHDIFF)
        SELECT {vals_sql}, CURRENT_TIMESTAMP(), 'STREAMLIT_APP', UUID_STRING(),
               TRUE, CURRENT_DATE(), MD5('{hashkey_src}'), MD5('{hashdiff_src}')
    """
    session.sql(sql).collect()




def update_entry(old_pk, data, modified_by=""):
    safe_old = {k: str(v).replace("'", "''") for k, v in old_pk.items()}
    safe_email = modified_by.replace("'", "''") if modified_by else "unknown"
    transaction_started = False
    try:
        session.sql("BEGIN").collect()
        transaction_started = True
        check_cnt = session.sql(f"""
            SELECT COUNT(*) as cnt FROM {TABLE}
            WHERE SOURCE_SYSTEM = '{safe_old["SOURCE_SYSTEM"]}'
              AND INTERFACE_NAME = '{safe_old["INTERFACE_NAME"]}'
              AND DATABASE_NAME = '{safe_old["DATABASE_NAME"]}'
              AND PSG_TABLE_NAME = '{safe_old["PSG_TABLE_NAME"]}'
              AND AUDIT_CURRENT = TRUE
        """).to_pandas()['CNT'].iloc[0]
        if check_cnt == 0:
            raise RuntimeError("This entry was already modified or deleted by another user. Please refresh and try again.")
        session.sql(f"""
            UPDATE {TABLE}
            SET AUDIT_CURRENT = FALSE, AUDIT_END_DATE = CURRENT_DATE(),
                AUDIT_FILE_NAME = 'UPDATED_BY:{safe_email}',
                AUDIT_FILE_PROCESSED_DATE = CURRENT_TIMESTAMP()
            WHERE SOURCE_SYSTEM = '{safe_old["SOURCE_SYSTEM"]}'
              AND INTERFACE_NAME = '{safe_old["INTERFACE_NAME"]}'
              AND DATABASE_NAME = '{safe_old["DATABASE_NAME"]}'
              AND PSG_TABLE_NAME = '{safe_old["PSG_TABLE_NAME"]}'
              AND AUDIT_CURRENT = TRUE
        """).collect()
        insert_entry(data)
        session.sql("COMMIT").collect()
        transaction_started = False
    except Exception:
        if transaction_started:
            try:
                session.sql("ROLLBACK").collect()
            except Exception:
                pass
        raise


