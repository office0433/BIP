def render_html_table(df):
    if df.empty:
        return '<p style="color:#8b95a5;font-size:13px;">No data available.</p>'
    headers = "".join(f"<th>{html_escape(col)}</th>" for col in df.columns)
    rows = ""
    for _, row in df.iterrows():
        cells = "".join(f"<td>{html_escape(row[col])}</td>" for col in df.columns)
        rows += f"<tr>{cells}</tr>"
    return f"""
    <div style="overflow-x:auto;">
    <table class="history-table">
        <thead><tr>{headers}</tr></thead>
        <tbody>{rows}</tbody>
    </table>
    </div>
    """


def render_dashboard_table(df, name_col, count_col="Count"):
    rows_html = ""
    for _, row in df.iterrows():
        count_value = "" if is_missing_value(row[count_col]) else str(int(row[count_col]))
        rows_html += f"<tr><td>{html_escape(row[name_col])}</td><td>{html_escape(count_value)}</td></tr>"
    return f"""
    <table class="dashboard-table">
        <thead><tr><th>{html_escape(name_col)}</th><th>{html_escape(count_col)}</th></tr></thead>
        <tbody>{rows_html}</tbody>
    </table>
    """


