def validate_form(data):
    errors = {"missing": [], "dropdown": [], "spaces": [], "trailing": [], "confluence": [], "db_prefix": []}
    for field, value in data.items():
        label = FIELD_LABELS.get(field, field)
        if field == "EXPIRATION_DATE":
            continue
        if value is None:
            if field in OPTIONAL_FIELDS:
                pass
            elif field in DROPDOWN_FIELDS:
                errors["dropdown"].append(label)
            else:
                errors["missing"].append(label)
        elif isinstance(value, str):
            val = value.strip()
            if not val or val == PLACEHOLDER:
                if field in OPTIONAL_FIELDS:
                    pass
                elif field in DROPDOWN_FIELDS:
                    errors["dropdown"].append(label)
                else:
                    errors["missing"].append(label)
            else:
                if "  " in value:
                    errors["spaces"].append(label)
                if value.startswith(" ") or value.endswith(" "):
                    errors["trailing"].append(label)
                if field in ("HLD", "IFM") and not val.startswith(CONFLUENCE_PREFIX):
                    errors["confluence"].append(label)
                if field == "DATABASE_NAME" and not val.upper().startswith(DB_NAME_PREFIX):
                    errors["db_prefix"].append(label)
    if data.get("ENCRYPTED") == "YES" and not data.get("EXPIRATION_DATE"):
        errors["missing"].append(FIELD_LABELS["EXPIRATION_DATE"])
    result = []
    if errors["missing"]:
        result.append(("Mandatory fields left empty", errors["missing"]))
    if errors["dropdown"]:
        result.append(("Please select a value for", errors["dropdown"]))
    if errors["confluence"]:
        result.append((f"URL must begin with {CONFLUENCE_PREFIX} for", errors["confluence"]))
    if errors["db_prefix"]:
        result.append((f"Value must begin with {DB_NAME_PREFIX} for", errors["db_prefix"]))
    if errors["spaces"]:
        result.append(("Multiple consecutive spaces found in", errors["spaces"]))
    if errors["trailing"]:
        result.append(("Leading or trailing spaces found in", errors["trailing"]))
    return result


UPPERCASE_FIELDS = {"SOURCE_SYSTEM", "INTERFACE_NAME", "DATABASE_NAME", "PSG_TABLE_NAME", "STAGE_TABLE_NAME"}

def clean_all_fields(data):
    cleaned = {}
    for key, value in data.items():
        if value is None:
            cleaned[key] = ""
        elif isinstance(value, str):
            v = clean_input(value)
            v = "" if v == PLACEHOLDER else v
            if key in UPPERCASE_FIELDS and v:
                v = v.upper()
            cleaned[key] = v
        else:
            cleaned[key] = str(value)
    return cleaned


def inline_field_error(value, field_name, encrypted_value=None):
    """Return an error message for a single field, or None if valid.
    Only shows errors when the field has been touched (non-empty / changed from default)."""
    if field_name == "EXPIRATION_DATE":
        if encrypted_value == "YES" and not value:
            return "Required when Encrypted is YES"
        return None

    if field_name in DROPDOWN_FIELDS:
        if value is not None and isinstance(value, str) and value != PLACEHOLDER:
            return None  # valid selection
        if value == PLACEHOLDER:
            return None  # not touched yet, don't nag
        return None

    if value is None or not isinstance(value, str):
        return None
    val = value.strip()
    if not val:
        return None  # empty = not touched yet, Save button will catch it
    if "  " in value:
        return "Multiple consecutive spaces not allowed"
    if value.startswith(" ") or value.endswith(" "):
        return "Leading or trailing spaces not allowed"
    if field_name in ("HLD", "IFM") and not val.startswith(CONFLUENCE_PREFIX):
        return f"Must begin with {CONFLUENCE_PREFIX}"
    if field_name == "DATABASE_NAME" and not val.upper().startswith(DB_NAME_PREFIX):
        return f"Must begin with {DB_NAME_PREFIX}"
    return None


def show_inline_error(value, field_name, encrypted_value=None):
    """Display an inline error below a field if validation fails."""
    err = inline_field_error(value, field_name, encrypted_value)
    if err:
        st.markdown(f'<span class="field-error">⚠ {err}</span>', unsafe_allow_html=True)


