def provision_tab(session: Session, created_by: str) -> None:
    st.markdown(
        '<p class="help-text">Use this tab to create new access only. To extend or modify existing access, use the Manage tab.</p>',
        unsafe_allow_html=True,
    )
    with st.form("provision_form", clear_on_submit=False):
        email = st.text_input(
            "User email (full address required)",
            placeholder="name@coles.com.au",
            key="prov_email",
        )
        groups = selected_groups("prov_grp")
        now = dt.datetime.now()

        c1, c2 = st.columns(2)
        with c1:
            from_date = st.date_input("Start date", value=now.date(), key="prov_fd")
        with c2:
            from_time = st.time_input(
                "Start time",
                value=dt.time(9, 0),
                step=dt.timedelta(minutes=15),
                key="prov_ft",
            )

        c3, c4 = st.columns(2)
        with c3:
            st.markdown("End date")
            st.markdown('<div class="readonly-field">31 Dec 2099</div>', unsafe_allow_html=True)
            to_date = DEFAULT_END_DATE
        with c4:
            st.markdown("End time")
            st.markdown('<div class="readonly-field">11:59 PM</div>', unsafe_allow_html=True)
            to_time = DEFAULT_END_TIME

        submitted = st.form_submit_button("Provision Access", use_container_width=True)

    if not submitted:
        return

    clean = norm_email(email)
    start_dt = combine_dt(from_date, from_time)
    end_dt = combine_dt(to_date, to_time)

    if not valid_email(clean):
        st.error("Invalid email. Enter a full valid email address.")
        return
    if not groups:
        st.error("Select at least one group.")
        return
    err = window_error(start_dt, end_dt)
    if err:
        st.error(err)
        return

    try:
        existing_current = check_existing_current(session, clean, groups)
        if not existing_current.empty:
            st.error(
                "Duplicate access blocked. This user already has active or scheduled access "
                "for one or more selected groups. Use Manage to extend or revoke it."
            )
            show_table(existing_current)
            return

        overlaps = find_overlaps(session, clean, groups, start_dt, end_dt)
        if not overlaps.empty:
            st.error(
                "Duplicate access blocked. The requested access window overlaps existing access "
                "for one or more selected groups."
            )
            show_table(overlaps)
            return
    except Exception as ex:
        st.error(f"Duplicate check failed: {ex}")
        return

    try:
        insert_access(session, clean, groups, start_dt, end_dt, created_by)
        set_flash_ok(
            f"Access enabled for {clean}. Groups: {', '.join(groups)}. "
            f"Window: {fmt_dt(start_dt)} to {fmt_dt(end_dt)}."
        )
        st.rerun()
    except Exception as ex:
        st.error(f"Provision failed: {ex}")


