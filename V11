def calc_counts(df: pd.DataFrame) -> dict:
    if df.empty or "Status" not in df.columns:
        return {"Total": 0, "Active": 0, "Scheduled": 0, "Expired": 0}
    status = df["Status"].fillna("")
    return {
        "Total": len(df),
        "Active": int((status == "Active").sum()),
        "Scheduled": int((status == "Scheduled").sum()),
        "Expired": int((status == "Expired").sum()),
    }


def row_key_predicate(row: Any) -> str:
    email = esc(norm_email(row["Email"]))
    group = esc(row["Group"])
    created_key = esc(row["Created Key"])
    return (
        f"LOWER(UPN) = '{email}' "
        f"AND USER_GROUP_NAME = '{group}' "
        f"AND COALESCE(TO_VARCHAR(CREATED_TS, '{TS_FMT}'), '') = '{created_key}'"
    )


def selected_row_count(s: Session, row: Any) -> int:
    df = run_df(s, f"SELECT COUNT(*) AS C FROM {TABLE_NAME} WHERE {row_key_predicate(row)}")
    return int(df.iloc[0, 0])


def require_selected_row(s: Session, row: Any) -> None:
    count = selected_row_count(s, row)
    if count != 1:
        raise RuntimeError(
            f"Selected record match count is {count}. Refresh the search and try again."
        )


def find_overlaps(
    s: Session,
    email: str,
    groups: List[str],
    start_dt: dt.datetime,
    end_dt: dt.datetime,
    exclude_row: Any = None,
) -> pd.DataFrame:
    if not groups:
        return pd.DataFrame()
    group_values = ", ".join(f"'{esc(g)}'" for g in groups)
    exclude = ""
    if exclude_row is not None:
        exclude = f" AND NOT ({row_key_predicate(exclude_row)})"
    return run_df(
        s,
        f"""
        SELECT UPN AS "Email",
               USER_GROUP_NAME AS "Group",
               FROM_DATE AS "Existing From",
               TO_DATE AS "Existing To",
               {status_sql()} AS "Status"
        FROM {TABLE_NAME}
        WHERE LOWER(UPN) = '{esc(norm_email(email))}'
          AND USER_GROUP_NAME IN ({group_values})
          AND FROM_DATE < {ts(end_dt)}
          AND TO_DATE > {ts(start_dt)}
          {exclude}
        ORDER BY USER_GROUP_NAME, FROM_DATE
        """,
    )


def check_existing_current(s: Session, email: str, groups: List[str]) -> pd.DataFrame:
    if not groups:
        return pd.DataFrame()
    group_values = ", ".join(f"'{esc(g)}'" for g in groups)
    return run_df(
        s,
        f"""
        SELECT UPN AS "Email",
               USER_GROUP_NAME AS "Group",
               FROM_DATE AS "From Date",
               TO_DATE AS "To Date",
               {status_sql()} AS "Status"
        FROM {TABLE_NAME}
        WHERE LOWER(UPN) = '{esc(norm_email(email))}'
          AND USER_GROUP_NAME IN ({group_values})
          AND TO_DATE > CURRENT_TIMESTAMP()
        ORDER BY USER_GROUP_NAME, FROM_DATE
        """,
    )


def insert_access(
    s: Session,
    email: str,
    groups: List[str],
    start_dt: dt.datetime,
    end_dt: dt.datetime,
    created_by: str,
) -> None:
    rows = ",\n".join(
        (
            f"('{esc(norm_email(email))}', '{esc(g)}', {ts(start_dt)}, {ts(end_dt)}, "
            f"CURRENT_TIMESTAMP(), '{esc(norm_email(created_by) or 'unknown')}', NULL, NULL)"
        )
        for g in groups
    )
    try:
        s.sql("BEGIN").collect()
        s.sql(
            f"""
            INSERT INTO {TABLE_NAME}
                (UPN, USER_GROUP_NAME, FROM_DATE, TO_DATE, CREATED_TS, CREATED_BY, UPDATED_TS, UPDATED_BY)
            SELECT v.*
            FROM VALUES {rows}
                 AS v(UPN, USER_GROUP_NAME, FROM_DATE, TO_DATE, CREATED_TS, CREATED_BY, UPDATED_TS, UPDATED_BY)
            """
        ).collect()
        s.sql("COMMIT").collect()
    except Exception:
        try:
            s.sql("ROLLBACK").collect()
        except Exception:
            pass
        raise


def update_access_window(
    s: Session,
    row: Any,
    start_dt: dt.datetime,
    end_dt: dt.datetime,
    updated_by: str,
) -> None:
    require_selected_row(s, row)
    predicate = row_key_predicate(row)
    s.sql(
        f"""
        UPDATE {TABLE_NAME}
        SET FROM_DATE = {ts(start_dt)},
            TO_DATE = {ts(end_dt)},
            UPDATED_TS = CURRENT_TIMESTAMP(),
            UPDATED_BY = '{esc(norm_email(updated_by) or 'unknown')}'
        WHERE {predicate}
        """
    ).collect()
    verify = run_df(
        s,
        f"""
        SELECT COUNT(*) AS C
        FROM {TABLE_NAME}
        WHERE {predicate}
          AND FROM_DATE = {ts(start_dt)}
          AND TO_DATE = {ts(end_dt)}
        """,
    )
    if int(verify.iloc[0, 0]) != 1:
        raise RuntimeError("The selected record was not updated. Refresh the search and try again.")


def remove_access(s: Session, row: Any, updated_by: str) -> None:
    require_selected_row(s, row)
    predicate = row_key_predicate(row)
    s.sql(
        f"""
        UPDATE {TABLE_NAME}
        SET TO_DATE = CURRENT_TIMESTAMP(),
            UPDATED_TS = CURRENT_TIMESTAMP(),
            UPDATED_BY = '{esc(norm_email(updated_by) or 'unknown')}'
        WHERE {predicate}
          AND TO_DATE > CURRENT_TIMESTAMP()
        """
    ).collect()
    verify = run_df(
        s,
        f"""
        SELECT COUNT(*) AS C
        FROM {TABLE_NAME}
        WHERE {predicate}
          AND TO_DATE <= CURRENT_TIMESTAMP()
        """,
    )
    if int(verify.iloc[0, 0]) != 1:
        raise RuntimeError("The selected record was not revoked. Refresh the search and try again.")


def selected_groups(prefix: str) -> List[str]:
    selected = []
    cols = st.columns(2)
    for i, group in enumerate(GROUPS):
        with cols[i % 2]:
            if st.checkbox(group, key=f"{prefix}_{group}"):
                selected.append(group)
    return selected


def window_error(start_dt: Optional[dt.datetime], end_dt: Optional[dt.datetime]) -> Optional[str]:
    if start_dt is None or end_dt is None:
        return "Both start and end date/time are required."
    if start_dt >= end_dt:
        return "Start must be before end."
    return None


