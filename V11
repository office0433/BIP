@st.cache_resource(show_spinner=False)
def get_session() -> Session:
    return Session.builder.getOrCreate()


def norm_email(v: Any) -> str:
    return re.sub(r"\s+", "", str(v or "").strip().lower())


def valid_email(v: str) -> bool:
    return bool(EMAIL_RE.match(norm_email(v)))


def esc(v: Any) -> str:
    return str(v or "").replace("'", "''")


def ts(v: dt.datetime) -> str:
    return f"TO_TIMESTAMP_NTZ('{v.strftime('%Y-%m-%d %H:%M:%S.%f')}', 'YYYY-MM-DD HH24:MI:SS.FF6')"


def combine_dt(d: dt.date, t: dt.time) -> Optional[dt.datetime]:
    if d is None or t is None:
        return None
    return dt.datetime.combine(d, t if isinstance(t, dt.time) else t.time())


def as_dt(v: Any) -> Optional[dt.datetime]:
    if v is None:
        return None
    try:
        if pd.isna(v):
            return None
    except Exception:
        pass
    if isinstance(v, dt.datetime):
        return v.replace(tzinfo=None)
    try:
        p = pd.to_datetime(v)
        return None if pd.isna(p) else p.to_pydatetime().replace(tzinfo=None)
    except Exception:
        return None


def fmt_dt(v: Any) -> str:
    p = as_dt(v)
    return p.strftime("%d %b %Y %I:%M %p") if p else ""


def current_user_email(s: Session) -> str:
    try:
        u = getattr(st, "user", None)
        e = u.get("email") if u and hasattr(u, "get") else getattr(u, "email", None)
        e = norm_email(e)
        if e:
            return e
    except Exception:
        pass
    try:
        return norm_email(s.sql("SELECT CURRENT_USER()").to_pandas().iloc[0, 0]) or "unknown"
    except Exception:
        return "unknown"


def run_df(s: Session, sql: str) -> pd.DataFrame:
    return s.sql(sql).to_pandas()


def status_sql() -> str:
    return (
        "CASE "
        "WHEN TO_DATE <= CURRENT_TIMESTAMP() THEN 'Expired' "
        "WHEN FROM_DATE > CURRENT_TIMESTAMP() THEN 'Scheduled' "
        "WHEN FROM_DATE <= CURRENT_TIMESTAMP() AND TO_DATE > CURRENT_TIMESTAMP() THEN 'Active' "
        "ELSE 'Expired' END"
    )


def search_terms(search: str) -> List[str]:
    return [t for t in re.split(r"[\s,;]+", search.strip().lower()) if t]


def add_email_search_filter(where: List[str], search: str) -> None:
    for term in search_terms(search):
        where.append(f"LOWER(UPN) LIKE '%{esc(term)}%'")


def search_rank_sql(search: str) -> str:
    clean = esc(search.strip().lower())
    if not clean:
        return "0"
    return (
        f"CASE "
        f"WHEN LOWER(UPN) = '{clean}' THEN 0 "
        f"WHEN LOWER(UPN) LIKE '{clean}%' THEN 1 "
        f"WHEN LOWER(UPN) LIKE '%{clean}%' THEN 2 "
        f"ELSE 3 END"
    )


def load_access(
    s: Session,
    search: str = "",
    show_active: bool = True,
    show_expired: bool = False,
    limit: int = 300,
) -> pd.DataFrame:
    where = ["1 = 1"]
    add_email_search_filter(where, search)
    if show_active and not show_expired:
        where.append("FROM_DATE <= CURRENT_TIMESTAMP() AND TO_DATE > CURRENT_TIMESTAMP()")
    elif show_expired and not show_active:
        where.append("TO_DATE <= CURRENT_TIMESTAMP()")
    elif show_active and show_expired:
        where.append("((FROM_DATE <= CURRENT_TIMESTAMP() AND TO_DATE > CURRENT_TIMESTAMP()) OR TO_DATE <= CURRENT_TIMESTAMP())")

    return run_df(
        s,
        f"""
        SELECT UPN AS "Email",
               USER_GROUP_NAME AS "Group",
               FROM_DATE AS "From Date",
               TO_DATE AS "To Date",
               {status_sql()} AS "Status",
               CREATED_BY AS "Created By",
               CREATED_TS AS "Created At",
               UPDATED_BY AS "Updated By",
               UPDATED_TS AS "Updated At",
               TO_VARCHAR(CREATED_TS, '{TS_FMT}') AS "Created Key"
        FROM {TABLE_NAME}
        WHERE {" AND ".join(where)}
        ORDER BY {search_rank_sql(search)}, LOWER(UPN), USER_GROUP_NAME, FROM_DATE DESC
        LIMIT {int(limit)}
        """,
    )


def load_manage_access(s: Session, search: str = "", limit: int = 500) -> pd.DataFrame:
    where = ["1 = 1"]
    add_email_search_filter(where, search)
    return run_df(
        s,
        f"""
        SELECT UPN AS "Email",
               USER_GROUP_NAME AS "Group",
               FROM_DATE AS "From Date",
               TO_DATE AS "To Date",
               {status_sql()} AS "Status",
               CREATED_BY AS "Created By",
               CREATED_TS AS "Created At",
               UPDATED_BY AS "Updated By",
               UPDATED_TS AS "Updated At",
               TO_VARCHAR(CREATED_TS, '{TS_FMT}') AS "Created Key"
        FROM {TABLE_NAME}
        WHERE {" AND ".join(where)}
        ORDER BY {search_rank_sql(search)}, LOWER(UPN), USER_GROUP_NAME, FROM_DATE DESC
        LIMIT {int(limit)}
        """,
    )


def show_table(df: pd.DataFrame) -> None:
    if df.empty:
        st.info("No records found.")
        return
    out = df.copy()
    for col in ["From Date", "To Date", "Created At", "Updated At", "Existing From", "Existing To"]:
        if col in out.columns:
            out[col] = out[col].apply(fmt_dt)
    out = out.drop(columns=[c for c in ["Created Key"] if c in out.columns], errors="ignore")
    st.dataframe(out, use_container_width=True, hide_index=True)


