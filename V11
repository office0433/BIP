            new_fd = st.date_input("Start date", value=cur_from.date(), key=f"ufd_{sfx}")
            new_ft = st.time_input(
                "Start time",
                value=cur_from.time().replace(microsecond=0),
                step=dt.timedelta(minutes=15),
                key=f"uft_{sfx}",
            )
            new_td = st.date_input(
                "End date",
                value=cur_to.date(),
                min_value=min_end_date,
                max_value=max_end_date,
                key=f"utd_{sfx}",
            )
            new_tt = st.time_input(
                "End time",
                value=cur_to.time().replace(microsecond=0),
                step=dt.timedelta(minutes=15),
                key=f"utt_{sfx}",
            )
            do_update = st.form_submit_button("Update Dates", use_container_width=True)

    with action_col2:
        st.markdown('<div class="section-label">Revoke access</div>', unsafe_allow_html=True)
        if row["Status"] in ("Active", "Scheduled"):
            st.warning("This will immediately terminate access for the user.")
            revoke_key = f"{row['Email']}|{row['Group']}|{row['Created Key']}"
            if st.session_state.get("_confirm_rm") != revoke_key:
                if st.button("Revoke Access", use_container_width=True, key=f"rm_btn_{sfx}", type="primary"):
                    st.session_state["_confirm_rm"] = revoke_key
                    st.rerun()
            else:
                st.markdown(
                    '<div class="danger-zone"><p>Are you sure? This will expire access immediately.</p></div>',
                    unsafe_allow_html=True,
                )
                if st.button(
                    "Yes - Revoke Now",
                    use_container_width=True,
                    key=f"yes_rm_{sfx}",
                    type="primary",
                ):
                    try:
                        remove_access(session, row, updated_by)
                        st.session_state["_confirm_rm"] = None
                        set_flash_ok(
                            f"Access revoked for {row['Email']} / {row['Group']}. "
                            "It has been expired immediately."
                        )
                        st.rerun()
                    except Exception as ex:
                        st.error(f"Revoke failed: {ex}")
                if st.button("Cancel", use_container_width=True, key=f"no_rm_{sfx}"):
                    st.session_state["_confirm_rm"] = None
                    st.rerun()
        else:
            st.info("This record is already expired. Nothing to revoke.")

    if do_update:
        new_start = combine_dt(new_fd, new_ft)
        new_end = combine_dt(new_td, new_tt)
        err = window_error(new_start, new_end)
        if err:
            st.error(err)
            return

        try:
            overlaps = find_overlaps(
                session,
                row["Email"],
                [row["Group"]],
                new_start,
                new_end,
                exclude_row=row,
            )
            if not overlaps.empty:
                st.error("Update blocked. The new date window overlaps another record for this user/group.")
                show_table(overlaps)
                return

            old_from = fmt_dt(row["From Date"])
            old_to = fmt_dt(row["To Date"])
            update_access_window(session, row, new_start, new_end, updated_by)
            set_flash_ok(
                f"Dates updated for {row['Email']} / {row['Group']}. "
                f"Previous: {old_from} to {old_to}. "
                f"New: {fmt_dt(new_start)} to {fmt_dt(new_end)}."
            )
            st.rerun()
        except Exception as ex:
            st.error(f"Update failed: {ex}")


def main() -> None:
    try:
        session = get_session()
    except Exception as ex:
        st.error(f"Cannot connect to Snowflake: {ex}")
        st.stop()

    user_email = current_user_email(session)
    render_header(user_email)
    show_flash()

    t1, t2, t3 = st.tabs(["VIEW ACCESS", "PROVISION", "MANAGE"])
    with t1:
        view_tab(session)
    with t2:
        provision_tab(session, user_email)
    with t3:
        manage_tab(session, user_email)


if __name__ == "__main__":
    main()
