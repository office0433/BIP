    <p style="font-size:13px;color:#fff;font-weight:600;margin:2px 0 0;">{html.escape(email)}</p></div></div>""", unsafe_allow_html=True)


def view_tab(session):
    show_flash()
    st.markdown('<div class="section-label">Search user access</div>', unsafe_allow_html=True)
    email = st.text_input("Search email (partial OK)", key="view_email", placeholder="Type any part of email...")

    if not email.strip():
        st.markdown('<p class="help-text">Type any part of an email to search. Full address not required.</p>', unsafe_allow_html=True)
        return

    c1, c2, c3 = st.columns([1, 1, 2])
    with c1:
        show_active = st.checkbox("Active / Scheduled", value=False, key="view_show_active")
    with c2:
        show_expired = st.checkbox("Expired", value=False, key="view_show_expired")

    try:
        df = load_access(session, email, show_active, show_expired, 300)
    except Exception as e:
        st.error(f"Search failed: {e}")
        return

    counts = calc_counts(df)
    mc = st.columns(4)
    for col, (lbl, clr) in zip(mc, [("Total", "blue"), ("Active", "green"), ("Scheduled", "amber"), ("Expired", "red")]):
        with col:
            st.markdown(metric_card(counts[lbl], lbl, clr), unsafe_allow_html=True)

    st.markdown('<div class="section-label">Access records</div>', unsafe_allow_html=True)
    show_table(df)


def provision_tab(session, created_by):
    show_flash()
    st.markdown('<p class="help-text">Use this tab to create NEW access only. To extend or modify existing access, use the Manage tab.</p>', unsafe_allow_html=True)

    with st.form("provision_form", clear_on_submit=False):
        email = st.text_input("User email (full address required)", placeholder="name@coles.com.au", key="prov_email")
        groups = selected_groups("prov_grp")

        now = dt.datetime.now()
        default_to = now + dt.timedelta(days=30)
        c1, c2 = st.columns(2)
        with c1:
            from_date = st.date_input("Start date", value=now.date(), key="prov_fd")
        with c2:
            from_time = st.time_input("Start time", value=dt.time(9, 0), step=dt.timedelta(minutes=15), key="prov_ft")
        c3, c4 = st.columns(2)
        with c3:
            to_date = st.date_input("End date", value=default_to.date(), key="prov_td")
        with c4:
            to_time = st.time_input("End time", value=dt.time(17, 0), step=dt.timedelta(minutes=15), key="prov_tt")

        submitted = st.form_submit_button("Provision Access", use_container_width=True)

    if not submitted:
        return

    clean = norm_email(email)
    start_dt = combine_dt(from_date, from_time)
    end_dt = combine_dt(to_date, to_time)

    if not valid_email(clean):
        st.error("Invalid email. Enter a full valid email (e.g. user@coles.com.au).")
        return
    if not groups:
        st.error("Select at least one group.")
        return
    err = window_error(start_dt, end_dt)
    if err:
        st.error(err)
        return

    try:
        existing = check_existing_active(session, clean, groups)
        if not existing.empty:
            st.error("This user already has active or scheduled access for one or more selected groups. "
                     "You cannot provision duplicate access here. To extend or modify existing dates, go to the **Manage** tab.")
            show_table(existing)
            return
    except Exception as e:
        st.error(f"Error checking existing access: {e}")
        return

    try:
        insert_access(session, clean, groups, start_dt, end_dt, created_by)
        st.session_state["_flash_ok"] = (
            f"Access provisioned successfully. User: {clean}. "
            f"Groups: {', '.join(groups)}. "
            f"Window: {fmt_dt(start_dt)} to {fmt_dt(end_dt)}."
        )
        st.rerun()
    except Exception as e:
        st.error(f"Failed to provision access: {e}")


def manage_tab(session, updated_by):
    show_flash()
    st.markdown('<div class="section-label">Search user access</div>', unsafe_allow_html=True)
    email = st.text_input("Search email (partial OK)", key="manage_email", placeholder="Type any part of email...")

    if not email.strip():
        st.markdown('<p class="help-text">Type any part of an email to find records.</p>', unsafe_allow_html=True)
        return

    try:
        df = load_manage_access(session, email, 500)
    except Exception as e:
        st.error(f"Search failed: {e}")
        return

    if df.empty:
        st.info(f"No records found matching '{email.strip()}'.")
        return

    st.markdown('<div class="section-label">All records</div>', unsafe_allow_html=True)
    show_table(df)

    st.markdown('<div class="section-label">Select record to edit</div>', unsafe_allow_html=True)
    labels = [f"{r['Group']} | {r['Status']} | {fmt_dt(r['From Date'])} - {fmt_dt(r['To Date'])}" for _, r in df.iterrows()]
    idx = st.selectbox("Record", options=list(range(len(df))), format_func=lambda i: labels[i], key="manage_rec")

    row = df.iloc[idx]
    cur_from = as_dt(row["From Date"]) or dt.datetime.now()
    cur_to = as_dt(row["To Date"]) or (dt.datetime.now() + dt.timedelta(days=30))
    sfx = re.sub(r"[^A-Za-z0-9_]", "_", f"{row['Email']}_{row['Group']}_{row['Created Key']}")[:60]

    # ── UPDATE DATES (inside st.form so values persist on submit) ──
    st.markdown(f"**Editing:** {row['Group']} for {row['Email']} (currently {row['Status']})")

    with st.form(f"upd_form_{sfx}"):
        c1, c2 = st.columns(2)
        with c1:
            new_fd = st.date_input("Start date", value=cur_from.date(), key=f"ufd_{sfx}")
        with c2:
            new_ft = st.time_input("Start time", value=cur_from.time().replace(microsecond=0), step=dt.timedelta(minutes=15), key=f"uft_{sfx}")
        c3, c4 = st.columns(2)
        with c3:
            new_td = st.date_input("End date", value=cur_to.date(), key=f"utd_{sfx}")
        with c4:
            new_tt = st.time_input("End time", value=cur_to.time().replace(microsecond=0), step=dt.timedelta(minutes=15), key=f"utt_{sfx}")

        update_clicked = st.form_submit_button("Update Access Window", use_container_width=True)

    if update_clicked:
        new_start = combine_dt(new_fd, new_ft)
        new_end = combine_dt(new_td, new_tt)
        err = window_error(new_start, new_end)
        if err:
            st.error(err)
        else:
            try:
                dupes = find_overlaps(session, row["Email"], [row["Group"]], new_start, new_end, row)
                if not dupes.empty:
                    st.warning("Cannot update: new dates overlap with another record.")
                    show_table(dupes)
                else:
                    old_from_str = fmt_dt(row["From Date"])
                    old_to_str = fmt_dt(row["To Date"])
                    update_access_window(session, row, new_start, new_end, updated_by)
                    st.session_state["_flash_ok"] = (
                        f"Dates updated successfully. "
                        f"User: {row['Email']}. Group: {row['Group']}. "
                        f"Previous: {old_from_str} to {old_to_str}. "
                        f"New: {fmt_dt(new_start)} to {fmt_dt(new_end)}."
                    )
                    st.rerun()
            except Exception as ex:
                st.error(f"Failed to update: {ex}")

    # ── REVOKE ACCESS (always visible for Active/Scheduled) ──
    if row["Status"] in ("Active", "Scheduled"):
        st.markdown("---")
        rk = f"{row['Email']}|{row['Group']}|{row['Created Key']}"

        if st.session_state.get("_confirm_rm") != rk:
            st.warning(f"To immediately terminate access for **{row['Group']}**, click the button below.")
            if st.button("REVOKE ACCESS", use_container_width=True, key="rm_btn", type="primary"):
                st.session_state["_confirm_rm"] = rk
                st.rerun()
        else:
            st.markdown('<div class="danger-zone"><p>WARNING: This will immediately expire this access record. This action cannot be undone. Are you sure?</p></div>', unsafe_allow_html=True)
            r1, r2 = st.columns(2)
            with r1:
                if st.button("YES - REVOKE NOW", use_container_width=True, key="yes_rm", type="primary"):
                    try:
                        remove_access(session, row, updated_by)
                        st.session_state["_confirm_rm"] = None
                        st.session_state["_flash_ok"] = f"Access revoked for {row['Email']} / {row['Group']}. Expired immediately."
                        st.rerun()
                    except Exception as ex:
                        st.error(f"Failed to revoke: {ex}")
            with r2:
                if st.button("Cancel", use_container_width=True, key="no_rm"):
                    st.session_state["_confirm_rm"] = None
                    st.rerun()


def main():
    try:
        session = get_session()
    except Exception as e:
        st.error(f"Cannot connect to Snowflake: {e}")
        st.stop()
    user_email = current_user_email(session)
    render_header(user_email)
    t1, t2, t3 = st.tabs(["VIEW ACCESS", "PROVISION", "MANAGE"])
    with t1: view_tab(session)
    with t2: provision_tab(session, user_email)
    with t3: manage_tab(session, user_email)

if __name__ == "__main__":
    main()
