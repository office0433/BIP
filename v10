@st.cache_resource(show_spinner=False)
def get_session() -> Session:
    return Session.builder.getOrCreate()

def norm_email(v: Any) -> str:
    return re.sub(r"\s+", "", str(v or "").strip().lower())

def valid_email(v: str) -> bool:
    return bool(EMAIL_RE.match(norm_email(v)))

def esc(v: Any) -> str:
    return str(v or "").replace("'", "''")

def ts(v: dt.datetime) -> str:
    return f"TO_TIMESTAMP_NTZ('{v.strftime('%Y-%m-%d %H:%M:%S.%f')}', 'YYYY-MM-DD HH24:MI:SS.FF6')"

def combine_dt(d: dt.date, t: dt.time) -> Optional[dt.datetime]:
    if d is None or t is None: return None
    return dt.datetime.combine(d, t if isinstance(t, dt.time) else t.time())

def as_dt(v: Any) -> Optional[dt.datetime]:
    if v is None: return None
    try:
        if pd.isna(v): return None
    except Exception: pass
    if isinstance(v, dt.datetime): return v.replace(tzinfo=None)
    try:
        p = pd.to_datetime(v)
        return None if pd.isna(p) else p.to_pydatetime().replace(tzinfo=None)
    except Exception: return None

def fmt_dt(v: Any) -> str:
    p = as_dt(v)
    return p.strftime("%d %b %Y %I:%M %p") if p else ""

def current_user_email(s: Session) -> str:
    try:
        u = getattr(st, "user", None)
        e = u.get("email") if u and hasattr(u, "get") else getattr(u, "email", None)
        e = norm_email(e)
        if e: return e
    except Exception: pass
    try: return norm_email(s.sql("SELECT CURRENT_USER()").to_pandas().iloc[0, 0]) or "unknown"
    except Exception: return "unknown"

def run_df(s: Session, sql: str) -> pd.DataFrame:
    return s.sql(sql).to_pandas()

def status_sql() -> str:
    return "CASE WHEN TO_DATE <= CURRENT_TIMESTAMP() THEN 'Expired' WHEN FROM_DATE > CURRENT_TIMESTAMP() THEN 'Scheduled' WHEN FROM_DATE <= CURRENT_TIMESTAMP() AND TO_DATE > CURRENT_TIMESTAMP() THEN 'Active' ELSE 'Expired' END"

def load_access(s: Session, search: str = "", show_active: bool = True, show_expired: bool = True, limit: int = 300) -> pd.DataFrame:
    w = ["1 = 1"]
    c = esc(search.strip().lower())
    if c: w.append(f"LOWER(UPN) LIKE '%{c}%'")
    status_filter = []
    if show_active and not show_expired:
        w.append("(FROM_DATE <= CURRENT_TIMESTAMP() AND TO_DATE > CURRENT_TIMESTAMP()) OR (FROM_DATE > CURRENT_TIMESTAMP())")
    elif show_expired and not show_active:
        w.append("TO_DATE <= CURRENT_TIMESTAMP()")
    elif not show_active and not show_expired:
        pass  # show all
    return run_df(s, f"""
        SELECT UPN AS "Email", USER_GROUP_NAME AS "Group", FROM_DATE AS "From Date", TO_DATE AS "To Date",
               {status_sql()} AS "Status", CREATED_BY AS "Created By", CREATED_TS AS "Created At",
               UPDATED_BY AS "Updated By", UPDATED_TS AS "Updated At",
               TO_VARCHAR(CREATED_TS, '{TS_FMT}') AS "Created Key"
        FROM {TABLE_NAME} WHERE {" AND ".join(w)}
        ORDER BY LOWER(UPN), USER_GROUP_NAME, FROM_DATE DESC LIMIT {int(limit)}""")

def load_manage_access(s: Session, search: str = "", limit: int = 500) -> pd.DataFrame:
    w = ["1 = 1"]
    c = esc(search.strip().lower())
    if c: w.append(f"LOWER(UPN) LIKE '%{c}%'")
    return run_df(s, f"""
        SELECT UPN AS "Email", USER_GROUP_NAME AS "Group", FROM_DATE AS "From Date", TO_DATE AS "To Date",
               {status_sql()} AS "Status", CREATED_BY AS "Created By", CREATED_TS AS "Created At",
               UPDATED_BY AS "Updated By", UPDATED_TS AS "Updated At",
               TO_VARCHAR(CREATED_TS, '{TS_FMT}') AS "Created Key"
        FROM {TABLE_NAME} WHERE {" AND ".join(w)}
        ORDER BY LOWER(UPN), USER_GROUP_NAME, FROM_DATE DESC LIMIT {int(limit)}""")

def show_table(df: pd.DataFrame) -> None:
    if df.empty:
        st.info("No records found.")
        return
    out = df.copy()
    for col in ["From Date", "To Date", "Created At", "Updated At", "Existing From", "Existing To"]:
        if col in out.columns: out[col] = out[col].apply(fmt_dt)
    out = out.drop(columns=[c for c in ["Created Key"] if c in out.columns], errors="ignore")
    st.dataframe(out, use_container_width=True, hide_index=True)

def metric_card(v: int, label: str, color: str = "blue") -> str:
    return f'<div class="metric-card mc-{color}"><p class="metric-value">{int(v)}</p><p class="metric-label">{html.escape(label)}</p></div>'

def calc_counts(df: pd.DataFrame) -> dict:
    if df.empty or "Status" not in df.columns: return {"Total": 0, "Active": 0, "Scheduled": 0, "Expired": 0}
    st_col = df["Status"].fillna("")
    return {"Total": len(df), "Active": int((st_col == "Active").sum()), "Scheduled": int((st_col == "Scheduled").sum()), "Expired": int((st_col == "Expired").sum())}

def find_overlaps(s, email, groups, start_dt, end_dt, exclude_row=None):
    gv = ", ".join(f"'{esc(g)}'" for g in groups)
    ex = ""
    if exclude_row is not None:
        ex = f" AND NOT (LOWER(UPN) = '{esc(norm_email(exclude_row['Email']))}' AND USER_GROUP_NAME = '{esc(exclude_row['Group'])}' AND COALESCE(TO_VARCHAR(CREATED_TS, '{TS_FMT}'), '') = '{esc(exclude_row['Created Key'])}')"
    return run_df(s, f"""
        SELECT UPN AS "Email", USER_GROUP_NAME AS "Group", FROM_DATE AS "Existing From", TO_DATE AS "Existing To", {status_sql()} AS "Status"
        FROM {TABLE_NAME} WHERE LOWER(UPN) = '{esc(norm_email(email))}' AND USER_GROUP_NAME IN ({gv})
          AND FROM_DATE < {ts(end_dt)} AND TO_DATE > {ts(start_dt)}{ex} ORDER BY USER_GROUP_NAME, FROM_DATE""")

def check_existing_active(s, email, groups):
    gv = ", ".join(f"'{esc(g)}'" for g in groups)
    df = run_df(s, f"""
        SELECT UPN AS "Email", USER_GROUP_NAME AS "Group", FROM_DATE AS "From Date", TO_DATE AS "To Date", {status_sql()} AS "Status"
        FROM {TABLE_NAME} WHERE LOWER(UPN) = '{esc(norm_email(email))}' AND USER_GROUP_NAME IN ({gv})
          AND TO_DATE > CURRENT_TIMESTAMP() ORDER BY USER_GROUP_NAME""")
    return df

def insert_access(s, email, groups, start_dt, end_dt, created_by):
    rows = ",\n".join(f"('{esc(norm_email(email))}', '{esc(g)}', {ts(start_dt)}, {ts(end_dt)}, CURRENT_TIMESTAMP(), '{esc(norm_email(created_by) or 'unknown')}', NULL, NULL)" for g in groups)
    try:
        s.sql("BEGIN").collect()
        s.sql(f"INSERT INTO {TABLE_NAME} (UPN, USER_GROUP_NAME, FROM_DATE, TO_DATE, CREATED_TS, CREATED_BY, UPDATED_TS, UPDATED_BY) SELECT v.* FROM VALUES {rows} AS v(UPN, USER_GROUP_NAME, FROM_DATE, TO_DATE, CREATED_TS, CREATED_BY, UPDATED_TS, UPDATED_BY)").collect()
        s.sql("COMMIT").collect()
    except Exception:
        try: s.sql("ROLLBACK").collect()
        except Exception: pass
        raise

def update_access_window(s, row, start_dt, end_dt, updated_by):
    s.sql(f"UPDATE {TABLE_NAME} SET FROM_DATE = {ts(start_dt)}, TO_DATE = {ts(end_dt)}, UPDATED_TS = CURRENT_TIMESTAMP(), UPDATED_BY = '{esc(norm_email(updated_by) or 'unknown')}' WHERE LOWER(UPN) = '{esc(norm_email(row['Email']))}' AND USER_GROUP_NAME = '{esc(row['Group'])}' AND COALESCE(TO_VARCHAR(CREATED_TS, '{TS_FMT}'), '') = '{esc(row['Created Key'])}'").collect()

def remove_access(s, row, updated_by):
    s.sql(f"UPDATE {TABLE_NAME} SET TO_DATE = CURRENT_TIMESTAMP(), UPDATED_TS = CURRENT_TIMESTAMP(), UPDATED_BY = '{esc(norm_email(updated_by) or 'unknown')}' WHERE LOWER(UPN) = '{esc(norm_email(row['Email']))}' AND USER_GROUP_NAME = '{esc(row['Group'])}' AND COALESCE(TO_VARCHAR(CREATED_TS, '{TS_FMT}'), '') = '{esc(row['Created Key'])}' AND TO_DATE > CURRENT_TIMESTAMP()").collect()

def selected_groups(prefix):
    sel = []
    cols = st.columns(2)
    for i, g in enumerate(GROUPS):
        with cols[i % 2]:
            if st.checkbox(g, key=f"{prefix}_{g}"): sel.append(g)
    return sel

def window_error(s, e):
    if s is None or e is None: return "Both start and end date/time are required."
    if s >= e: return "Start must be before end."
    return None

def show_flash():
    m = st.session_state.pop("_flash_ok", None)
    if m: st.success(m)
    m = st.session_state.pop("_flash_err", None)
    if m: st.error(m)
