def view_tab(session: Session) -> None:
    st.markdown('<div class="section-label">Search</div>', unsafe_allow_html=True)

    email = st.text_input("User email", key="view_email", placeholder="name@coles.com")
    active_only = st.checkbox("Active only", value=True, key="view_active_only")

    if not email.strip():
        st.markdown('<span class="subtle-text">Enter an email address to view access.</span>', unsafe_allow_html=True)
        return

    try:
        df = load_access(session, email, active_only, 300)
    except Exception as error:
        st.error(f"Failed to load access: {error}")
        return

    counts = calc_counts(df)
    cols = st.columns(4)

    for col, label in zip(cols, ["Total", "Active", "Scheduled", "Expired"]):
        with col:
            show_metric(label, counts[label])

    st.markdown('<div class="section-label">Access</div>', unsafe_allow_html=True)
    show_table(df)


def provision_tab(session: Session, created_by: str) -> None:
    with st.form("provision_form", clear_on_submit=False):
        st.markdown('<div class="section-label">User</div>', unsafe_allow_html=True)
        email = st.text_input("User email", placeholder="name@coles.com", key="provision_email")

        st.markdown('<div class="section-label">Groups</div>', unsafe_allow_html=True)
        groups = selected_groups("provision_group")

        st.markdown('<div class="section-label">Access Window</div>', unsafe_allow_html=True)

        now = dt.datetime.now()
        default_to = now + dt.timedelta(days=30)

        col1, col2, col3, col4 = st.columns(4)

        with col1:
            from_date = st.date_input("From date", value=now.date(), key="provision_from_date")

        with col2:
            from_time = st.time_input(
                "From time",
                value=dt.time(9, 0),
                step=dt.timedelta(minutes=15),
                key="provision_from_time",
            )

        with col3:
            to_date = st.date_input("To date", value=default_to.date(), key="provision_to_date")

        with col4:
            to_time = st.time_input(
                "To time",
                value=dt.time(17, 0),
                step=dt.timedelta(minutes=15),
                key="provision_to_time",
            )

        submitted = st.form_submit_button("Provision Access", use_container_width=True)

    if not submitted:
        return

    clean_email = norm_email(email)
    start_dt = combine_date_time(from_date, from_time)
    end_dt = combine_date_time(to_date, to_time)

    if not valid_email(clean_email):
        st.error("Enter a valid user email.")
        return

    if not groups:
        st.error("Select at least one group.")
        return

    error = window_error(start_dt, end_dt)

    if error:
        st.error(error)
        return

    try:
        dupes = find_overlaps(session, clean_email, groups, start_dt, end_dt)

        if not dupes.empty:
            st.warning("Overlapping access already exists.")
            show_table(dupes)
            return

        insert_access(session, clean_email, groups, start_dt, end_dt, created_by)
        st.success(f"Provisioned {len(groups)} group{'s' if len(groups) != 1 else ''} for {clean_email}.")
    except Exception as error:
        st.error(f"Failed to provision access: {error}")


def manage_tab(session: Session, updated_by: str) -> None:
    st.markdown('<div class="section-label">Find Access</div>', unsafe_allow_html=True)

    email = st.text_input("User email", key="manage_email", placeholder="name@coles.com")

    if not email.strip():
        st.markdown('<span class="subtle-text">Enter an email address to manage access.</span>', unsafe_allow_html=True)
        return

    try:
        df = load_access(session, email, False, 500)
    except Exception as error:
        st.error(f"Failed to load access: {error}")
        return

    if df.empty:
        st.info("No access found.")
        return

    st.markdown('<div class="section-label">Records</div>', unsafe_allow_html=True)
    show_table(df)

    labels = [
        f"{row['Email']} | {row['Group']} | {fmt_dt(row['From Date'])} to {fmt_dt(row['To Date'])} | {row['Status']}"
        for _, row in df.iterrows()
    ]

    selected_index = st.selectbox(
        "Select record",
        options=list(range(len(df))),
        format_func=lambda index: labels[index],
        key="manage_record",
    )

    row = df.iloc[selected_index]

    current_from = as_dt(row["From Date"]) or dt.datetime.now()
    current_to = as_dt(row["To Date"]) or (dt.datetime.now() + dt.timedelta(days=30))
    suffix = re.sub(r"[^A-Za-z0-9_]", "_", f"{row['Email']}_{row['Group']}_{row['Created Key']}")[:100]

    st.markdown('<div class="section-label">Edit Window</div>', unsafe_allow_html=True)

    with st.form(f"update_form_{suffix}"):
        col1, col2, col3, col4 = st.columns(4)

        with col1:
            from_date = st.date_input("From date", value=current_from.date(), key=f"from_date_{suffix}")

        with col2:
            from_time = st.time_input(
                "From time",
                value=current_from.time().replace(microsecond=0),
                step=dt.timedelta(minutes=15),
                key=f"from_time_{suffix}",
            )

        with col3:
            to_date = st.date_input("To date", value=current_to.date(), key=f"to_date_{suffix}")

        with col4:
            to_time = st.time_input(
                "To time",
                value=current_to.time().replace(microsecond=0),
                step=dt.timedelta(minutes=15),
                key=f"to_time_{suffix}",
            )

        update_clicked = st.form_submit_button("Update Access Window", use_container_width=True)

    if update_clicked:
        start_dt = combine_date_time(from_date, from_time)
        end_dt = combine_date_time(to_date, to_time)

        error = window_error(start_dt, end_dt)

        if error:
            st.error(error)
            return

        try:
            dupes = find_overlaps(session, row["Email"], [row["Group"]], start_dt, end_dt, row)

            if not dupes.empty:
                st.warning("Updated window overlaps with another row.")
                show_table(dupes)
                return

            update_access_window(session, row, start_dt, end_dt, updated_by)
            st.success("Access window updated.")
            st.rerun()
        except Exception as error:
            st.error(f"Failed to update access: {error}")

    st.markdown('<div class="section-label">Remove Access</div>', unsafe_allow_html=True)

    remove_key = f"{row['Email']}|{row['Group']}|{row['Created Key']}"

    if st.session_state.get("confirm_remove_access") != remove_key:
        st.markdown('<div class="danger-btn">', unsafe_allow_html=True)
        clicked = st.button("Remove Access", use_container_width=True, key="remove_access")
        st.markdown("</div>", unsafe_allow_html=True)

        if clicked:
            st.session_state.confirm_remove_access = remove_key
            st.rerun()

    else:
        col1, col2 = st.columns(2)

        with col1:
            st.markdown('<div class="danger-btn">', unsafe_allow_html=True)
            confirm = st.button("Confirm Remove Access", use_container_width=True, key="confirm_remove_access_btn")
            st.markdown("</div>", unsafe_allow_html=True)

            if confirm:
                try:
                    remove_access(session, row, updated_by)
                    st.session_state.confirm_remove_access = None
                    st.success("Access removed.")
                    st.rerun()
                except Exception as error:
                    st.error(f"Failed to remove access: {error}")

        with col2:
            if st.button("Cancel", use_container_width=True, key="cancel_remove_access"):
                st.session_state.confirm_remove_access = None
                st.rerun()


def main() -> None:
    apply_theme()

    try:
        snowflake_session = get_session()
    except Exception as error:
        st.error(f"Unable to connect to Snowflake: {error}")
        st.stop()

    user_email = current_user_email(snowflake_session)

    render_header(user_email)

    tab1, tab2, tab3 = st.tabs(["View", "Provision", "Manage"])

    with tab1:
        view_tab(snowflake_session)

    with tab2:
        provision_tab(snowflake_session, user_email)

    with tab3:
        manage_tab(snowflake_session, user_email)


if __name__ == "__main__":
    main()