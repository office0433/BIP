# ── Snowflake helpers ──

@st.cache_resource(show_spinner=False)
def get_session() -> Session:
    return Session.builder.getOrCreate()


def norm_email(value: Any) -> str:
    return re.sub(r"\s+", "", str(value or "").strip().lower())


def valid_email(value: str) -> bool:
    return bool(EMAIL_RE.match(norm_email(value)))


def esc(value: Any) -> str:
    return str(value or "").replace("'", "''")


def ts(value: dt.datetime) -> str:
    return f"TO_TIMESTAMP_NTZ('{value.strftime('%Y-%m-%d %H:%M:%S.%f')}', 'YYYY-MM-DD HH24:MI:SS.FF6')"


def combine_date_time(date_value: dt.date, time_value: dt.time) -> Optional[dt.datetime]:
    if date_value is None or time_value is None:
        return None
    return dt.datetime.combine(date_value, time_value if isinstance(time_value, dt.time) else time_value.time())


def as_dt(value: Any) -> Optional[dt.datetime]:
    if value is None:
        return None
    try:
        if pd.isna(value):
            return None
    except Exception:
        pass
    if isinstance(value, dt.datetime):
        return value.replace(tzinfo=None)
    try:
        parsed = pd.to_datetime(value)
        if pd.isna(parsed):
            return None
        return parsed.to_pydatetime().replace(tzinfo=None)
    except Exception:
        return None


def fmt_dt(value: Any) -> str:
    parsed = as_dt(value)
    return parsed.strftime("%d %b %Y %I:%M %p") if parsed else ""


def current_user_email(session: Session) -> str:
    try:
        user = getattr(st, "user", None)
        email = user.get("email") if user and hasattr(user, "get") else getattr(user, "email", None)
        email = norm_email(email)
        if email:
            return email
    except Exception:
        pass
    try:
        return norm_email(session.sql("SELECT CURRENT_USER()").to_pandas().iloc[0, 0]) or "unknown"
    except Exception:
        return "unknown"


def run_df(session: Session, sql: str) -> pd.DataFrame:
    return session.sql(sql).to_pandas()


def status_sql() -> str:
    return """
        CASE
            WHEN TO_DATE <= CURRENT_TIMESTAMP() THEN 'Expired'
            WHEN FROM_DATE > CURRENT_TIMESTAMP() THEN 'Scheduled'
            WHEN FROM_DATE <= CURRENT_TIMESTAMP() AND TO_DATE > CURRENT_TIMESTAMP() THEN 'Active'
            ELSE 'Expired'
        END
    """


def load_access(session: Session, search_email: str = "", active_only: bool = False, limit: int = 300) -> pd.DataFrame:
    where_parts = ["1 = 1"]
    clean_email = esc(norm_email(search_email))
    if clean_email:
        where_parts.append(f"LOWER(UPN) LIKE '%{clean_email}%'")
    if active_only:
        where_parts.append("FROM_DATE <= CURRENT_TIMESTAMP()")
        where_parts.append("TO_DATE > CURRENT_TIMESTAMP()")
    where_sql = " AND ".join(where_parts)
    return run_df(session, f"""
        SELECT UPN AS "Email", USER_GROUP_NAME AS "Group",
               FROM_DATE AS "From Date", TO_DATE AS "To Date",
               {status_sql()} AS "Status",
               CREATED_BY AS "Created By", CREATED_TS AS "Created At",
               UPDATED_BY AS "Updated By", UPDATED_TS AS "Updated At",
               TO_VARCHAR(CREATED_TS, '{TS_FMT}') AS "Created Key"
        FROM {TABLE_NAME}
        WHERE {where_sql}
        ORDER BY LOWER(UPN), USER_GROUP_NAME, FROM_DATE DESC
        LIMIT {int(limit)}
    """)


def show_table(df: pd.DataFrame) -> None:
    if df.empty:
        st.info("No records found.")
        return
    out = df.copy()
    for col in ["From Date", "To Date", "Created At", "Updated At", "Existing From", "Existing To"]:
        if col in out.columns:
            out[col] = out[col].apply(fmt_dt)
    out = out.drop(columns=[c for c in ["Created Key"] if c in out.columns], errors="ignore")
    st.dataframe(out, use_container_width=True, hide_index=True)


def metric_card(value: int, label: str, color: str = "blue") -> str:
    return f'<div class="metric-card mc-{color}"><p class="metric-value">{int(value)}</p><p class="metric-label">{html.escape(label)}</p></div>'


def calc_counts(df: pd.DataFrame) -> dict:
    if df.empty or "Status" not in df.columns:
        return {"Total": 0, "Active": 0, "Scheduled": 0, "Expired": 0}
    status = df["Status"].fillna("")
    return {
        "Total": int(len(df)),
        "Active": int((status == "Active").sum()),
        "Scheduled": int((status == "Scheduled").sum()),
        "Expired": int((status == "Expired").sum()),
    }


def find_overlaps(session: Session, email: str, groups: list[str], start_dt: dt.datetime,
                   end_dt: dt.datetime, exclude_row: Optional[pd.Series] = None) -> pd.DataFrame:
    group_values = ", ".join(f"'{esc(group)}'" for group in groups)
    exclude_sql = ""
    if exclude_row is not None:
        exclude_sql = f"""
          AND NOT (LOWER(UPN) = '{esc(norm_email(exclude_row["Email"]))}'
              AND USER_GROUP_NAME = '{esc(exclude_row["Group"])}'
              AND COALESCE(TO_VARCHAR(CREATED_TS, '{TS_FMT}'), '') = '{esc(exclude_row["Created Key"])}')
        """
    return run_df(session, f"""
        SELECT UPN AS "Email", USER_GROUP_NAME AS "Group",
               FROM_DATE AS "Existing From", TO_DATE AS "Existing To",
               {status_sql()} AS "Status"
        FROM {TABLE_NAME}
        WHERE LOWER(UPN) = '{esc(norm_email(email))}'
          AND USER_GROUP_NAME IN ({group_values})
          AND FROM_DATE < {ts(end_dt)} AND TO_DATE > {ts(start_dt)}
          {exclude_sql}
        ORDER BY USER_GROUP_NAME, FROM_DATE
    """)


def insert_access(session: Session, email: str, groups: list[str], start_dt: dt.datetime,
                   end_dt: dt.datetime, created_by: str) -> None:
    rows_sql = ",\n".join(
        f"('{esc(norm_email(email))}', '{esc(group)}', {ts(start_dt)}, {ts(end_dt)}, "
        f"CURRENT_TIMESTAMP(), '{esc(norm_email(created_by) or 'unknown')}', NULL, NULL)"
        for group in groups
    )
    try:
        session.sql("BEGIN").collect()
        session.sql(f"""
            INSERT INTO {TABLE_NAME}
                (UPN, USER_GROUP_NAME, FROM_DATE, TO_DATE, CREATED_TS, CREATED_BY, UPDATED_TS, UPDATED_BY)
            SELECT v.UPN, v.USER_GROUP_NAME, v.FROM_DATE, v.TO_DATE, v.CREATED_TS, v.CREATED_BY, v.UPDATED_TS, v.UPDATED_BY
            FROM VALUES {rows_sql}
            AS v(UPN, USER_GROUP_NAME, FROM_DATE, TO_DATE, CREATED_TS, CREATED_BY, UPDATED_TS, UPDATED_BY)
        """).collect()
        session.sql("COMMIT").collect()
    except Exception:
        try:
            session.sql("ROLLBACK").collect()
        except Exception:
            pass
        raise


def update_access_window(session: Session, row: pd.Series, start_dt: dt.datetime,
                          end_dt: dt.datetime, updated_by: str) -> None:
    session.sql(f"""
        UPDATE {TABLE_NAME}
        SET FROM_DATE = {ts(start_dt)}, TO_DATE = {ts(end_dt)},
            UPDATED_TS = CURRENT_TIMESTAMP(),
            UPDATED_BY = '{esc(norm_email(updated_by) or 'unknown')}'
        WHERE LOWER(UPN) = '{esc(norm_email(row["Email"]))}'
          AND USER_GROUP_NAME = '{esc(row["Group"])}'
          AND COALESCE(TO_VARCHAR(CREATED_TS, '{TS_FMT}'), '') = '{esc(row["Created Key"])}'
    """).collect()


def remove_access(session: Session, row: pd.Series, updated_by: str) -> None:
    session.sql(f"""
        UPDATE {TABLE_NAME}
        SET TO_DATE = CURRENT_TIMESTAMP(), UPDATED_TS = CURRENT_TIMESTAMP(),
            UPDATED_BY = '{esc(norm_email(updated_by) or 'unknown')}'
        WHERE LOWER(UPN) = '{esc(norm_email(row["Email"]))}'
          AND USER_GROUP_NAME = '{esc(row["Group"])}'
          AND COALESCE(TO_VARCHAR(CREATED_TS, '{TS_FMT}'), '') = '{esc(row["Created Key"])}'
          AND TO_DATE > CURRENT_TIMESTAMP()
    """).collect()


def selected_groups(prefix: str) -> list[str]:
    selected = []
    cols = st.columns(2)
    for index, group in enumerate(GROUPS):
        with cols[index % 2]:
            if st.checkbox(group, key=f"{prefix}_{group}"):
                selected.append(group)
    return selected


def window_error(start_dt: Optional[dt.datetime], end_dt: Optional[dt.datetime]) -> Optional[str]:
    if start_dt is None or end_dt is None:
        return "From and To date/time are required."
    if start_dt >= end_dt:
        return "From must be before To."
    return None


