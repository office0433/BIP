# ── Tab: View ──

def view_tab(session: Session) -> None:
    st.markdown('<div class="section-label">Search user access</div>', unsafe_allow_html=True)

    c1, c2 = st.columns([3, 1])
    with c1:
        email = st.text_input("User email", key="view_email", placeholder="name@coles.com.au")
    with c2:
        st.markdown("<br>", unsafe_allow_html=True)
        active_only = st.checkbox("Active only", value=True, key="view_active_only")

    if not email.strip():
        st.markdown('<p class="help-text">Enter an email address to view access records.</p>', unsafe_allow_html=True)
        return

    try:
        df = load_access(session, email, active_only, 300)
    except Exception as error:
        st.error(f"Failed to load: {error}")
        return

    counts = calc_counts(df)
    mc1, mc2, mc3, mc4 = st.columns(4)
    with mc1:
        st.markdown(metric_card(counts["Total"], "Total", "blue"), unsafe_allow_html=True)
    with mc2:
        st.markdown(metric_card(counts["Active"], "Active", "green"), unsafe_allow_html=True)
    with mc3:
        st.markdown(metric_card(counts["Scheduled"], "Scheduled", "amber"), unsafe_allow_html=True)
    with mc4:
        st.markdown(metric_card(counts["Expired"], "Expired", "red"), unsafe_allow_html=True)

    st.markdown('<div class="section-label">Access records</div>', unsafe_allow_html=True)
    show_table(df)


# ── Tab: Provision ──

def provision_tab(session: Session, created_by: str) -> None:
    with st.form("provision_form", clear_on_submit=False):
        st.markdown('<div class="section-label">User</div>', unsafe_allow_html=True)
        email = st.text_input("User email", placeholder="name@coles.com.au", key="provision_email")

        st.markdown('<div class="section-label">Groups</div>', unsafe_allow_html=True)
        groups = selected_groups("provision_group")

        st.markdown('<div class="section-label">Start access</div>', unsafe_allow_html=True)
        now = dt.datetime.now()
        default_to = now + dt.timedelta(days=30)

        fc1, fc2 = st.columns(2)
        with fc1:
            from_date = st.date_input("Date", value=now.date(), key="prov_from_date")
        with fc2:
            from_time = st.time_input("Time", value=dt.time(9, 0), step=dt.timedelta(minutes=15), key="prov_from_time")

        st.markdown('<div class="section-label">End access</div>', unsafe_allow_html=True)

        fc3, fc4 = st.columns(2)
        with fc3:
            to_date = st.date_input("Date", value=default_to.date(), key="prov_to_date")
        with fc4:
            to_time = st.time_input("Time", value=dt.time(17, 0), step=dt.timedelta(minutes=15), key="prov_to_time")

        submitted = st.form_submit_button("Provision Access", use_container_width=True)

    if not submitted:
        return

    clean_email = norm_email(email)
    start_dt = combine_date_time(from_date, from_time)
    end_dt = combine_date_time(to_date, to_time)

    if not valid_email(clean_email):
        st.error("Enter a valid email address.")
        return
    if not groups:
        st.error("Select at least one group.")
        return
    error = window_error(start_dt, end_dt)
    if error:
        st.error(error)
        return

    try:
        dupes = find_overlaps(session, clean_email, groups, start_dt, end_dt)
        if not dupes.empty:
            st.warning("Overlapping access exists for this user and window.")
            show_table(dupes)
            return
        insert_access(session, clean_email, groups, start_dt, end_dt, created_by)
        st.success(f"Provisioned {len(groups)} group{'s' if len(groups) != 1 else ''} for {clean_email}.")
    except Exception as error:
        st.error(f"Failed: {error}")


# ── Tab: Manage ──

def manage_tab(session: Session, updated_by: str) -> None:
    st.markdown('<div class="section-label">Find user access</div>', unsafe_allow_html=True)
    email = st.text_input("User email", key="manage_email", placeholder="name@coles.com.au")

    if not email.strip():
        st.markdown('<p class="help-text">Enter an email address to manage access records.</p>', unsafe_allow_html=True)
        return

    try:
        df = load_access(session, email, False, 500)
    except Exception as error:
        st.error(f"Failed to load: {error}")
        return

    if df.empty:
        st.info("No access records found for this user.")
        return

    st.markdown('<div class="section-label">All records</div>', unsafe_allow_html=True)
    show_table(df)

    st.markdown('<div class="section-label">Edit record</div>', unsafe_allow_html=True)

    labels = [
        f"{row['Group']} | {row['Status']} | {fmt_dt(row['From Date'])} - {fmt_dt(row['To Date'])}"
        for _, row in df.iterrows()
    ]

    selected_index = st.selectbox("Select record", options=list(range(len(df))),
                                   format_func=lambda i: labels[i], key="manage_record")

    row = df.iloc[selected_index]
    current_from = as_dt(row["From Date"]) or dt.datetime.now()
    current_to = as_dt(row["To Date"]) or (dt.datetime.now() + dt.timedelta(days=30))
    suffix = re.sub(r"[^A-Za-z0-9_]", "_", f"{row['Email']}_{row['Group']}_{row['Created Key']}")[:80]

    st.markdown('<div class="section-label">Update start</div>', unsafe_allow_html=True)

    with st.form(f"update_form_{suffix}"):
        uc1, uc2 = st.columns(2)
        with uc1:
            from_date = st.date_input("Date", value=current_from.date(), key=f"fd_{suffix}")
        with uc2:
            from_time = st.time_input("Time", value=current_from.time().replace(microsecond=0),
                                       step=dt.timedelta(minutes=15), key=f"ft_{suffix}")

        st.markdown('<div class="section-label">Update end</div>', unsafe_allow_html=True)

        uc3, uc4 = st.columns(2)
        with uc3:
            to_date = st.date_input("Date", value=current_to.date(), key=f"td_{suffix}")
        with uc4:
            to_time = st.time_input("Time", value=current_to.time().replace(microsecond=0),
                                     step=dt.timedelta(minutes=15), key=f"tt_{suffix}")

        update_clicked = st.form_submit_button("Update Access Window", use_container_width=True)

    if update_clicked:
        start_dt = combine_date_time(from_date, from_time)
        end_dt = combine_date_time(to_date, to_time)
        error = window_error(start_dt, end_dt)
        if error:
            st.error(error)
            return
        try:
            dupes = find_overlaps(session, row["Email"], [row["Group"]], start_dt, end_dt, row)
            if not dupes.empty:
                st.warning("Updated window overlaps with another record.")
                show_table(dupes)
                return
            update_access_window(session, row, start_dt, end_dt, updated_by)
            st.success("Access window updated.")
            st.rerun()
        except Exception as error:
            st.error(f"Failed: {error}")

    # Remove access
    if row["Status"] == "Active" or row["Status"] == "Scheduled":
        st.markdown('<div class="section-label">Revoke access</div>', unsafe_allow_html=True)

        remove_key = f"{row['Email']}|{row['Group']}|{row['Created Key']}"

        if st.session_state.get("confirm_remove") != remove_key:
            if st.button("Revoke This Access", use_container_width=True, key="remove_btn"):
                st.session_state.confirm_remove = remove_key
                st.rerun()
        else:
            st.markdown("""<div class="danger-zone">
                <p>This will immediately expire this access record. Are you sure?</p>
            </div>""", unsafe_allow_html=True)

            rc1, rc2 = st.columns(2)
            with rc1:
                if st.button("Yes, revoke now", use_container_width=True, key="confirm_revoke"):
                    try:
                        remove_access(session, row, updated_by)
                        st.session_state.confirm_remove = None
                        st.success("Access revoked.")
                        st.rerun()
                    except Exception as error:
                        st.error(f"Failed: {error}")
            with rc2:
                if st.button("Cancel", use_container_width=True, key="cancel_revoke"):
                    st.session_state.confirm_remove = None
                    st.rerun()


# ── Main ──

def main() -> None:
    try:
        session = get_session()
    except Exception as error:
        st.error(f"Unable to connect to Snowflake: {error}")
        st.stop()

    user_email = current_user_email(session)
    render_header(user_email)

    tab1, tab2, tab3 = st.tabs(["VIEW ACCESS", "PROVISION", "MANAGE"])

    with tab1:
        view_tab(session)
    with tab2:
        provision_tab(session, user_email)
    with tab3:
        manage_tab(session, user_email)


if __name__ == "__main__":
    main()
    